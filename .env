# Global env vars
POSTGRES_DB=airflow
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# API
API_HOST=0.0.0.0
API_PORT=8000

# AIRFLOW
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__FERNET_KEY=fernet_please_change_me_123
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow
AIRFLOW__WEBSERVER__RBAC=True
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW_UID=50000

# Data folders (mounted into Airflow and used by scripts)
RAW_DATA_DIR=/opt/airflow/data/raw_data
GOOD_DATA_DIR=/opt/airflow/data/good_data
BAD_DATA_DIR=/opt/airflow/data/bad_data
PREDICTIONS_DIR=/opt/airflow/data/predictions
REPORTS_DIR=/opt/airflow/data/reports

# FastAPI DB URL (app DB for predictions & stats)
APP_DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/predictions

# Teams Webhook for Airflow alerts
TEAMS_WEBHOOK_URL=https://epitafr.webhook.office.com/webhookb2/1a32835b-aea2-48ee-861d-b6e829f09b9c@3534b3d7-316c-4bc9-9ede-605c860f49d2/IncomingWebhook/b45b688cfcff43afa3d7cfda5c2d0f6b/a813c23b-b77e-4d21-b81e-d456434f5ef9/V2s9JIwLd9XunRbl7Xs4hEBPbWQN0sJu4hQ96A28lVvGI1