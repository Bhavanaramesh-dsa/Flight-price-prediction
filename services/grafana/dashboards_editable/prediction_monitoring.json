          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    CASE\n        WHEN prediction < 1000 THEN '0–1k'\n        WHEN prediction < 2000 THEN '1k–2k'\n        WHEN prediction < 3000 THEN '2k–3k'\n        WHEN prediction < 4000 THEN '3k–4k'\n        ELSE '4k+'\n    END AS metric,\n    COUNT(*) AS value\nFROM prediction\nWHERE created_at > NOW() - INTERVAL '30 minutes'\nGROUP BY metric\nORDER BY MIN(prediction);\n",
