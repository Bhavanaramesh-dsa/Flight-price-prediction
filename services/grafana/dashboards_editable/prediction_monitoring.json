            "type": "grafana-postgresql-datasource",
            "uid": "postgres_ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH serving AS (\n    SELECT \n        date_trunc('minute', created_at) AS t,\n        AVG(NULLIF((features->>'duration')::float, 0)) AS serving_mean\n    FROM prediction\n    WHERE created_at > NOW() - INTERVAL '1 hour'\n      AND (features->>'duration') IS NOT NULL\n    GROUP BY 1\n),\ntraining AS (\n    SELECT duration_mean, duration_std\n    FROM training_stats\n    ORDER BY created_at DESC\n    LIMIT 1\n)\nSELECT\n    s.t AS time,\n    ABS(s.serving_mean - t.duration_mean) AS value\nFROM serving s\nCROSS JOIN training t\nORDER BY s.t;\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Feature Drift: duration (Serving vs Training Mean)",
      "type": "gauge"
    },
